# Für Docker: nach .env kopieren. Lokal: `uv run --env-file .env uvicorn backend.main:app`

# Optional: Zugangscode, wenn der Server im Netz erreichbar ist
ACCESS_CODE=

# KI-Bewertung am Ende: auto | claude-cli | anthropic | openai | local | none
# JUDGE_PROVIDER=auto
# JUDGE_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1

# Intent-Erkennung
# INTENT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# INTENT_THRESHOLD=0.72
# INTENT_EMBEDDINGS=1

# Nur für JUDGE_PROVIDER=local
# LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# LLM_DEVICE=cpu
