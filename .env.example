# Für Docker: nach .env kopieren. Lokal: `uv run --env-file .env uvicorn backend.main:app`

# Login (nur für `docker compose --profile public`, siehe README „Öffentlich betreiben“)
# AUTH_HEADER=X-Forwarded-Email
# DOMAIN=fallbeispiel.example.org
# LOGIN_PROVIDER=google
# OAUTH2_PROXY_CLIENT_ID=
# OAUTH2_PROXY_CLIENT_SECRET=
# OAUTH2_PROXY_COOKIE_SECRET=   # erzeugen mit: openssl rand -base64 32 | tr -- '+/' '-_'

# KI-Bewertungen pro Person und Stunde
# FEEDBACK_LIMIT=20

# KI-Bewertung am Ende: auto | claude-cli | anthropic | openai | local | none
# JUDGE_PROVIDER=auto
# JUDGE_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1

# Intent-Erkennung
# INTENT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# INTENT_THRESHOLD=0.72
# INTENT_EMBEDDINGS=1

# Nur für JUDGE_PROVIDER=local
# LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# LLM_DEVICE=cpu
