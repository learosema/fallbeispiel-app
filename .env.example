# Für Docker: nach .env kopieren. Lokal: `uv run --env-file .env uvicorn backend.main:app`

# Port auf dem Server, auf den der Reverse Proxy zeigt (nur lokal erreichbar)
# APP_PORT=8000

# API-Aufrufe pro Client-IP und Minute (0 = aus)
# RATE_LIMIT=300
# Von welchen Adressen X-Forwarded-For geglaubt wird (Docker-Standard: *, da Port 8000 nur lokal offen ist)
# FORWARDED_ALLOW_IPS=*

# Intent-Erkennung
# INTENT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# INTENT_THRESHOLD=0.72
# INTENT_EMBEDDINGS=1
